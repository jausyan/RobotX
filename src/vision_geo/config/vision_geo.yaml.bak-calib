vision_geo_node:
  ros__parameters:
    input_mode: "device"          # "device" | "topic"
    input_source: "/dev/video0"
    use_camera_info: false
    camera_info_topic: "/iris_with_camera_2/camera/camera_info"
    camera_matrix: [504.99132615, 0.0, 318.4012728,
                    0.0, 506.13168687, 243.99035432,
                    0.0, 0.0, 1.0]
    distortion_coeffs: [0.07771398, -0.18711237, -0.00182709, 0.00026326, -0.06212367]
    cam_to_body_rpy: [180.0, 0.0, 0.0]
    model_path: "/home/robotx/RobotX/models/b1.onnx"
    input_width: 320
    input_height: 320
    letterbox: true                 # keep the aspect ratio into the model (16:9 camera -> no squashing)
    # camera device mode — C922: 1280x720 MJPG 30 fps = full sensor width (default 640x480 crops the sides)
    camera_width: 640
    camera_height: 480
    camera_fourcc: "MJPG"
    camera_fps: 30
    # camera_matrix / distortion_coeffs below must match THIS mode -> run script/calibrate_camera.py
    conf_threshold: 0.4
    nms_threshold: 0.45
    # OpenVINO (same as vision_video). false = OpenCV DNN
    use_openvino: true
    openvino_device: "CPU"
    openvino_model_path: ""        # empty = model_path (.onnx); or an OpenVINO IR .xml
    class_names:   ["buoy_black", "buoy_blue", "circle_blue", "buoy_green", "circle_green", "buoy_red", "circle_red"]
    object_size_m: [0.4,        0.4,          0.4,         0.4,        0.65,         0.65,           0.65]  # real size per class (solvePnP)
    gps_topic:     "/rian/global_position/global"     # MAVROS namespace = control (rian/...)
    pose_topic:    "/rian/local_position/pose"
    rel_alt_topic: "/rian/global_position/rel_alt"
    use_fixed_pose: false
    fixed_lat: 0.0
    fixed_lon: 0.0
    fixed_altitude_m: 15.0
    max_pose_age_ms: 500
    altitude_offset_m: 0.0        # takeoff point height above the water [m] (e.g. 1.0 from a deck)
    output_topic:    "/vision_geo/detections"
    marker_topic:    "/vision_geo/markers"
    marker_frame_id: "map"
    marker_lifetime_s: 0.0        
    marker_size: 0.8              
    pixel_match_radius_px: 100.0  
    track_exit_frames: 5          
    min_obs_to_commit: 5          
    map_merge_radius_m: 2.0       
    show_window: false
    window_name: "vision_geo"
    # GStreamer stream (same as vision_hailo): RTP/H.264 over UDP
    enable_stream: true
    stream_host: "192.168.0.115"          # ground station IP
    stream_port: 5000
    stream_width: 640
    stream_height: 480
    stream_fps: 15
    stream_bitrate_kbps: 2000
    stream_undistort: false         # straighten ONLY the stream (detection/GPS keep the raw image)
    stream_undistort_alpha: 1.0     # 1.0 = whole view (black curved borders), 0.0 = crop to clean rectangle
    order_topic: "/mission/order"         
    wait_for_order: true                  
    target_topic_prefix: "/vision_geo/target/"   
    map_topic_prefix:    "/vision_geo/map/"      
    pose_frame_id: "camera"
