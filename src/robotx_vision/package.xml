<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotx_vision</name>
  <version>0.2.0</version>
  <description>RobotX UAV vision node: ONNX/OpenVINO detection, geo-referencing, GStreamer stream, driven by /mission/order</description>
  <maintainer email="you@example.com">maintainer</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <!-- your custom package providing DetectedObject / DetectedObjectArray -->
  <depend>vision_msgs</depend>
  <!-- apt build (has GStreamer support, needed for the UDP stream) -->
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- pip: openvino (for use_openvino), onnx (optional, reads class names from the model) -->
  <exec_depend>ros2launch</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
